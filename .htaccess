# =====================================================================
# Site Pr. Elias — raiz do projeto (funciona na raiz do domínio OU em
# subpasta, ex.: https://eliasjosedasilva.com.br/site_new/)
# =====================================================================

# Necessário para o mod_rewrite em muitas hospedagens compartilhadas
# (sem isso, qualquer RewriteRule gera erro 403 Forbidden)
Options +SymLinksIfOwnerMatch -Indexes

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) Bloqueia acesso direto às pastas internas
    RewriteRule ^(config|app|database)/ - [F]

    # 2) Arquivos que existem de verdade são servidos direto (css, js, imagens)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # 3) Assets e uploads ficam dentro de public/ — mapeia o caminho
    RewriteRule ^((assets|uploads)/.*)$ public/$1 [L]

    # 4) Todo o resto vai para o front controller da raiz
    RewriteCond %{REQUEST_URI} !/public/index\.php$
    RewriteRule ^ index.php [L]
</IfModule>

# Protege arquivos sensíveis
<FilesMatch "\.(sql|log|md)$">
    Require all denied
</FilesMatch>
