# Usado quando o domínio aponta DIRETAMENTE para a pasta public/
# (quando aponta para a raiz do projeto, quem age é o .htaccess da raiz)

Options +SymLinksIfOwnerMatch -Indexes

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Não reescreve arquivos e pastas reais (css, js, imagens, uploads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Segurança: bloqueia acesso a arquivos sensíveis
<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

