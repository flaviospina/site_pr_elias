# Roteia todas as requisições para o index.php (front controller)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Não reescreve arquivos e pastas que existem de verdade (css, js, imagens, uploads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Sem RewriteBase: mantém o funcionamento correto em subpastas
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Segurança: bloqueia acesso a arquivos sensíveis
<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>

